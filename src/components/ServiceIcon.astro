---
interface Props {
	name: 'web' | 'automation' | 'infrastructure' | 'security' | 'consulting';
}

const { name } = Astro.props;
---

<svg class="service-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
	{name === 'web' && <g><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01M8 13l-2 2 2 2M12 17h4" /></g>}
	{name === 'automation' && <g><rect x="3" y="4" width="7" height="6" rx="1" /><rect x="14" y="14" width="7" height="6" rx="1" /><path d="M10 7h3a3 3 0 0 1 3 3v4M14 17h-3a3 3 0 0 1-3-3v-1" /><path d="m12 11-2 2 2 2" /></g>}
	{name === 'infrastructure' && <g><rect x="4" y="3" width="16" height="8" rx="1.5" /><rect x="4" y="13" width="16" height="8" rx="1.5" /><path d="M8 7h.01M11 7h5M8 17h.01M11 17h5" /></g>}
	{name === 'security' && <g><path d="M12 3 19 6v5c0 4.7-2.9 8-7 10-4.1-2-7-5.3-7-10V6l7-3Z" /><path d="m9 12 2 2 4-4" /></g>}
	{name === 'consulting' && <g><circle cx="10.5" cy="10.5" r="6.5" /><path d="m16 16 4.5 4.5M8 12l1.7-2 1.5 1 2.3-3" /></g>}
</svg>
