---
import Brand from '../components/Brand.astro';
import ServiceIcon from '../components/ServiceIcon.astro';
import SocialLinks from '../components/SocialLinks.astro';
import Layout from '../layouts/Layout.astro';

const services = [
	{ icon: 'web', title: 'Web Development', description: 'Websites and software solutions tailored to your business.', tags: ['Corporate websites & landing pages', 'WordPress websites', 'Web applications', 'Custom software', 'Business management systems'] },
	{ icon: 'automation', title: 'Automation & AI Solutions', description: 'Business process automation and intelligent solutions that save time.', tags: ['n8n workflow automation', 'AI agents for WhatsApp', 'Automated customer support', 'Business process automation', 'API integrations'] },
	{ icon: 'infrastructure', title: 'Hosting & Infrastructure', description: 'Deployment and management of the infrastructure behind your digital services.', tags: ['Website hosting', 'Domain & DNS management', 'VPS deployment and management', 'SSL/TLS configuration', 'Server maintenance'] },
	{ icon: 'security', title: 'Maintenance & Support', description: 'Ongoing technical maintenance and support for websites and applications.', tags: ['Website maintenance', 'Bug fixes', 'Content and software updates', 'Backups and monitoring', 'Technical support'] },
	{ icon: 'consulting', title: 'SEO & Optimization', description: 'Technical improvements to boost website performance and search visibility.', tags: ['Technical SEO', 'Website speed optimization', 'Core Web Vitals', 'Search engine indexing', 'Metadata and structured data'] },
];

const orbitServices = services.slice(0, 3).flatMap((service) => service.tags);

const projects = [
	// Replace null with an optimized WebP screenshot when an approved preview is available.
	{
		name: 'Corporate Website',
		category: 'Web Development',
		description: 'A professional, responsive business website featuring structured service pages, company information, contact functionality, and search-friendly architecture.',
		url: 'https://corporate-web-dixply.netlify.app/',
		previewImage: null,
		previewType: 'corporate',
	},
	{
		name: 'Business Management System',
		category: 'Web Applications',
		description: 'An interactive business management application featuring operational dashboards, inventory management, sales tracking, customer records, and data visualization.',
		url: 'https://business-management-dixply.netlify.app/',
		previewImage: null,
		previewType: 'management',
	},
	{
		name: 'AI-Powered Customer Support',
		category: 'Automation & AI Solutions',
		description: 'An interactive customer support demonstration featuring conversational interfaces, automated response flows, quick replies, and simulated customer interactions.',
		url: 'https://ai-support-dixply.netlify.app/',
		previewImage: null,
		previewType: 'support',
	},
];

---

<Layout>
	<header class="absolute inset-x-0 top-0 z-10">
		<div class="site-shell flex h-20 items-center justify-between">
			<Brand href="#home" />
			<div class="header-actions">
				<nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
					<a class="nav-link" href="#services">Services</a>
					<a class="nav-link" href="#work">Portfolio</a>
					<a class="nav-link" href="#about">About</a>
					<a class="nav-link" href="#contact">Contact</a>
				</nav>
				<a class="button button-light" href="mailto:hello@dixply.com">Let’s talk</a>
			</div>
		</div>
	</header>

	<main>
		<section class="hero-section relative overflow-hidden bg-navy text-white" id="home">
			<div class="hero-grid" aria-hidden="true"></div>
			<div class="site-shell hero-content relative grid items-center gap-16 lg:grid-cols-[1.15fr_.85fr]">
				<div class="max-w-2xl">
					<h1>Make technology<br class="hidden sm:block" /> work for <span class="text-blue-300">your business.</span></h1>
					<p class="hero-copy">We build useful digital tools, connect the systems you rely on, and make the technical side of business easier to manage.</p>
					<div class="mt-9 flex flex-wrap items-center gap-5">
						<a class="button button-blue" href="mailto:hello@dixply.com">Talk about your project <span aria-hidden="true">↗</span></a>
						<a class="text-link text-link-light" href="#services">Explore what we do <span aria-hidden="true">↓</span></a>
					</div>

				</div>
				<div class="hero-visual" data-services={JSON.stringify(orbitServices)} aria-hidden="true">
					<div class="orbit orbit-one"></div><div class="orbit orbit-two"></div>
					<div class="orbit-track">
						<span class="orbit-particle particle-top"></span><span class="orbit-particle particle-right"></span><span class="orbit-particle particle-left"></span>
						<div class="node-position node-top"><div class="visual-node" data-service-node><span class="node-label">{orbitServices[0]}</span></div></div>
						<div class="node-position node-right"><div class="visual-node" data-service-node><span class="node-label">{orbitServices[1]}</span></div></div>
						<div class="node-position node-left"><div class="visual-node" data-service-node><span class="node-label">{orbitServices[2]}</span></div></div>
					</div>
					<div class="visual-core"><span class="core-ring"></span><img class="core-logo" src="/dixply-dyson.png" alt="" width="48" height="48" loading="eager" /><span class="core-center-light"></span></div>
				</div>
			</div>
			
		</section>

		<section class="section-space bg-white" id="services">
			<div class="site-shell">
				<div class="section-heading section-heading-group">
					<p class="eyebrow"><span class="eyebrow-mark"></span> What we do</p>
					<div class="split-heading grid gap-6 md:grid-cols-2">
						<h2>Technology that<br />moves work forward.</h2>
						<p class="section-intro">From a first business website to the systems behind your daily operations, get practical technical support shaped around your business.</p>
					</div>
				</div>
				<div class="service-list">
					{services.map((service) => (
						<article class="service-row">
							<div class="service-main"><ServiceIcon name={service.icon as 'web' | 'automation' | 'infrastructure' | 'security' | 'consulting'} /><div><h3>{service.title}</h3><p>{service.description}</p></div></div>
							<ul class="service-tags" aria-label={`${service.title} includes`}>
								{service.tags.map((tag) => <li>{tag}</li>)}
							</ul>
							<a class="service-arrow" href="mailto:hello@dixply.com" aria-label={`Ask about ${service.title}`}>↗</a>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="section-space section-soft" id="about">
			<div class="site-shell">
				<div class="section-heading section-heading-group">
					<p class="eyebrow"><span class="eyebrow-mark"></span> About Dixply</p>
					<div class="split-heading grid gap-6 md:grid-cols-2">
						<h2>Technology built around<br />what matters.</h2>
						<p class="section-intro">We pair thoughtful security practices with focused delivery and budget-conscious decisions, so each solution fits your business from the start.</p>
					</div>
				</div>
				<div class="benefit-grid grid gap-4 md:grid-cols-3">
					<article class="benefit-card"><div class="benefit-heading"><span class="benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M12 3 19 6v5c0 4.7-2.9 8-7 10-4.1-2-7-5.3-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg></span><h3>Security You Can Trust</h3></div><p>We build security into every stage of development, applying best practices to protect your data, reduce vulnerabilities, and keep your systems secure from the ground up.</p></article>
					<article class="benefit-card"><div class="benefit-heading"><span class="benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M13.2 2.8 5.8 13h5.4l-.6 8.2L18.2 11h-5.4l.4-8.2Z"/></svg></span><h3>From Idea to Launch, Faster</h3></div><p>We focus on efficient development, clear priorities, and streamlined workflows to deliver practical solutions faster—without cutting corners on quality.</p></article>
					<article class="benefit-card"><div class="benefit-heading"><span class="benefit-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9"/><path d="M15 8.8c-.6-.7-1.5-1.1-2.8-1.1-1.5 0-2.5.7-2.5 1.8 0 2.9 5.8 1.2 5.8 4.5 0 1.3-1.2 2.3-3 2.3-1.3 0-2.5-.5-3.2-1.4M12 5.8v12.4"/></svg></span><h3>Cut Costs, Not Corners</h3></div><p>We build cost-effective software and automation solutions that help reduce unnecessary expenses without compromising on quality, security, or performance.</p></article>
				</div>
			</div>
		</section>

		<section class="section-space bg-white" id="work">
			<div class="site-shell">
				<div class="section-heading section-heading-group">
					<p class="eyebrow"><span class="eyebrow-mark"></span> INTERACTIVE SHOWCASE</p>
					<div class="split-heading portfolio-heading grid gap-6 md:grid-cols-2">
						<h2><span class="portfolio-title-gradient">Digital Solutions</span><br />in Action.</h2>
						<p class="portfolio-note">Explore practical digital solutions for real business needs, from corporate websites and management systems to intelligent customer support workflows.</p>
					</div>
				</div>
				<div class="project-grid grid gap-5 lg:grid-cols-3">
					{projects.map((project) => (
						<article class="project-card">
							<a class={`project-preview project-preview-${project.previewType}`} href={project.url} target="_blank" rel="noopener noreferrer" aria-label={`View ${project.name} demo in a new tab`}>
								{project.previewImage ? (
									<img src={project.previewImage} alt={`Screenshot of the ${project.name} demo`} loading="lazy" />
								) : (
									<div class="project-placeholder" aria-hidden="true">
										<svg viewBox="0 0 48 48" fill="none">
											{project.previewType === 'corporate' && <g><rect x="8" y="9" width="32" height="30" rx="3" /><path d="M8 17h32M15 13h.01M19 13h.01M15 23h10M15 28h18M15 33h13" /></g>}
											{project.previewType === 'management' && <g><rect x="7" y="8" width="34" height="32" rx="3" /><path d="M7 17h34M13 13h.01M17 13h.01M14 33v-6m8 6V22m8 11v-9m-17-2h4m4-4h5m5 3h4" /></g>}
											{project.previewType === 'support' && <g><path d="M9 10a4 4 0 0 1 4-4h22a4 4 0 0 1 4 4v20a4 4 0 0 1-4 4H21l-9 7v-7a4 4 0 0 1-3-4V10Z" /><path d="M16 17h16m-16 7h11" /></g>}
										</svg>
									</div>
								)}
								<span class="demo-stamp"><i aria-hidden="true"></i> LIVE DEMO</span>
							</a>
							<div class="project-info">
								<div class="project-title-line"><div><p class="project-category">{project.category}</p><h3>{project.name}</h3></div></div>
								<p>{project.description}</p>
								<a class="project-demo-link" href={project.url} target="_blank" rel="noopener noreferrer">View Demo <span aria-hidden="true">↗</span></a>
							</div>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="contact-section bg-navy text-white" id="contact">
			<div class="site-shell contact-layout grid gap-12 lg:grid-cols-[1fr_.78fr] lg:items-center">
				<div><p class="eyebrow eyebrow-light"><span class="eyebrow-mark"></span> Contact</p><h2>Have a project<br />in mind?</h2><p class="contact-copy">Tell us what you are trying to improve. We’ll take it from there, one clear step at a time.</p><a class="button button-blue" href="mailto:hello@dixply.com">Email hello@dixply.com <span aria-hidden="true">↗</span></a></div>
				<form class="contact-form" id="contact-form" novalidate>
					<div class="form-heading"><span>Project inquiry</span><span class="form-status"><i></i> Send a request</span></div>
					<div class="form-grid">
						<div class="form-field"><label for="contact-name">Name <span class="required-mark" aria-hidden="true">*</span></label><input id="contact-name" name="name" type="text" autocomplete="name" maxlength="100" required aria-describedby="contact-name-error" /><p class="field-error" id="contact-name-error"></p></div>
						<div class="form-field"><label for="contact-email">Email <span class="required-mark" aria-hidden="true">*</span></label><input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required aria-describedby="contact-email-error" /><p class="field-error" id="contact-email-error"></p></div>
						<div class="form-field form-field-full"><label for="contact-details">Project details <span class="required-mark" aria-hidden="true">*</span></label><textarea id="contact-details" name="details" rows="4" maxlength="3000" required aria-describedby="contact-details-error contact-details-count"></textarea><div class="field-meta"><p class="field-error" id="contact-details-error"></p><span id="contact-details-count">0 / 3000</span></div></div>
					</div>
					<div class="honeypot" aria-hidden="true"><label for="contact-website">Website</label><input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" /></div>
					<div class="form-feedback" id="contact-feedback" role="status" aria-live="polite"></div>
					<button class="contact-submit button button-blue" type="submit"><span class="submit-label">Send project inquiry</span><span class="submit-icon" aria-hidden="true">↗</span></button>
				</form>
			</div>
		</section>
	</main>

	<footer class="site-footer">
		<div class="site-shell footer-main"><div><Brand href="#home" /><p>Technology for business, built with care.</p></div><div class="footer-links"><a href="#home">Home</a><a href="#services">Services</a><a href="#work">Portfolio</a><a href="#about">About</a><a href="#contact">Contact</a><a href="/faq/">FAQ</a><a href="mailto:hello@dixply.com">hello@dixply.com</a></div><SocialLinks /></div>
		<div class="site-shell footer-bottom"><span>© {new Date().getFullYear()} Dixply</span><span>Independent technology services · dixply.com</span></div>
	</footer>
</Layout>

<script>
	const serviceOrbit = document.querySelector<HTMLElement>('.hero-visual[data-services]');

	if (serviceOrbit && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const labels = JSON.parse(serviceOrbit.dataset.services ?? '[]') as string[];
		const nodes = Array.from(serviceOrbit.querySelectorAll<HTMLElement>('[data-service-node]'));
		let nextIndex = nodes.length;

		window.setInterval(() => {
			const batchStart = nextIndex;
			nodes.forEach((node, nodeIndex) => {
				window.setTimeout(() => {
					node.classList.add('is-changing');
					window.setTimeout(() => {
						const label = node.querySelector<HTMLElement>('.node-label');
						if (label) label.textContent = labels[(batchStart + nodeIndex) % labels.length];
						node.classList.remove('is-changing');
					}, 260);
				}, nodeIndex * 280);
			});
			nextIndex = (nextIndex + nodes.length) % labels.length;
		}, 3600);
	}
	const contactForm = document.querySelector<HTMLFormElement>('#contact-form');

	if (contactForm) {
		const submitButton = contactForm.querySelector<HTMLButtonElement>('button[type="submit"]');
		const submitLabel = contactForm.querySelector<HTMLElement>('.submit-label');
		const feedback = contactForm.querySelector<HTMLElement>('#contact-feedback');
		const details = contactForm.querySelector<HTMLTextAreaElement>('#contact-details');
		const detailsCount = contactForm.querySelector<HTMLElement>('#contact-details-count');
		let submitting = false;

		const errorFor = (name: string) => contactForm.querySelector<HTMLElement>(`#contact-${name}-error`);
		const fieldFor = (name: string) => contactForm.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;

		const clearFieldError = (name: string) => {
			const field = fieldFor(name);
			const error = errorFor(name);
			if (field) field.removeAttribute('aria-invalid');
			if (error) error.textContent = '';
		};

		const showFieldError = (name: string, message: string) => {
			const field = fieldFor(name);
			const error = errorFor(name);
			if (field) field.setAttribute('aria-invalid', 'true');
			if (error) error.textContent = message;
		};

		const validateField = (name: string) => {
			const field = fieldFor(name);
			if (!field || !(field instanceof HTMLInputElement || field instanceof HTMLSelectElement || field instanceof HTMLTextAreaElement)) return true;

			let message = '';
			if (!field.validity.valid) {
				if (field.validity.valueMissing) message = name === 'details' ? 'Tell us a little about your project.' : name === 'email' ? 'Enter your email.' : 'Enter your name.';
				else if (field.validity.typeMismatch) message = 'Enter a valid email address.';
				else if (field.validity.tooLong && !(field instanceof HTMLSelectElement)) message = `Use ${field.maxLength} characters or fewer.`;
			}
			if (message) showFieldError(name, message);
			else clearFieldError(name);
			return !message;
		};

		['name', 'email', 'details'].forEach((name) => {
			const field = fieldFor(name);
			field?.addEventListener('blur', () => validateField(name));
			field?.addEventListener(field instanceof HTMLSelectElement ? 'change' : 'input', () => {
				if (field.getAttribute('aria-invalid') === 'true') validateField(name);
			});
		});

		if (details && detailsCount) {
			details.addEventListener('input', () => { detailsCount.textContent = `${details.value.length} / 3000`; });
		}

		contactForm.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (submitting) return;

			const valid = ['name', 'email', 'details'].map(validateField).every(Boolean);
			if (!valid) {
				contactForm.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
				if (feedback) { feedback.textContent = 'Please correct the highlighted fields.'; feedback.className = 'form-feedback is-error'; }
				return;
			}

			submitting = true;
			if (submitButton) submitButton.disabled = true;
			if (submitLabel) submitLabel.textContent = 'Sending…';
			if (feedback) { feedback.textContent = ''; feedback.className = 'form-feedback'; }

			const data = new FormData(contactForm);
			try {
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(Object.fromEntries(data.entries())),
				});
				const result = await response.json().catch(() => ({ message: 'Your message could not be delivered. Please try again.' })) as { message?: string; errors?: Record<string, string> };

				if (!response.ok) {
					if (result.errors) Object.entries(result.errors).forEach(([name, message]) => showFieldError(name, message));
					if (feedback) { feedback.textContent = result.message ?? 'Your message could not be delivered. Please try again.'; feedback.className = 'form-feedback is-error'; }
					return;
				}

				contactForm.reset();
				if (detailsCount) detailsCount.textContent = '0 / 3000';
				['name', 'email', 'details'].forEach(clearFieldError);
				if (feedback) { feedback.textContent = result.message ?? 'Thanks. Your project inquiry has been sent.'; feedback.className = 'form-feedback is-success'; }
			} catch {
				if (feedback) { feedback.textContent = 'Your message could not be delivered. Check your connection and try again.'; feedback.className = 'form-feedback is-error'; }
			} finally {
				submitting = false;
				if (submitButton) submitButton.disabled = false;
				if (submitLabel) submitLabel.textContent = 'Send project inquiry';
			}
		});
	}
</script>
