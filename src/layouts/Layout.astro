---
import '../styles/global.css';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
const { title = 'Dixply', description = 'Dixply helps small businesses with web development, automation and AI, hosting and infrastructure, maintenance and support, and SEO optimization.' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" href="/brand-logo-white.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#111827" />
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<WhatsAppFloat />
	</body>
</html>
